# Copie para .env.local e preencha com os valores do projeto Supabase.

# Painel Supabase > Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Não usada pelo app (fica de fora do deploy). Só para scripts locais de teste
# que usam a Admin API, como criar um usuário já confirmado.
SUPABASE_SERVICE_ROLE_KEY=

# Painel Supabase > Settings > Database > Connection string (pooler, modo
# "transaction", porta 6543) — usada em runtime pelas funções serverless.
DATABASE_URL=

# Mesma connection string, mas porta 5432 (modo "session", sem
# ?pgbouncer=true) — usada só por drizzle-kit (generate/migrate/studio). O
# pooler em modo "transaction" não suporta DDL/prepared statements de forma
# confiável; migrations rodadas contra ele podem ser marcadas como aplicadas
# sem realmente criar as tabelas.
DIRECT_URL=
